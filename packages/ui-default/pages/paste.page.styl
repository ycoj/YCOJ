.pastebin-page
  .pastebin-content
    min-height: 22rem
    font-family: monospace
    white-space: pre
  .pastebin-list
    .section__list__item
      display: flex
      justify-content: space-between
      gap: 1rem
      a
        overflow: hidden
        text-overflow: ellipsis
        white-space: nowrap
  .pastebin-meta
    display: flex
    gap: 1.25rem
    flex-wrap: wrap
    margin-bottom: 1rem
  .pastebin-code
    overflow: auto
    white-space: pre
